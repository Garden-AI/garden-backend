{
  "serviceName": "",
  "containers": {
    "garden-backend-service": {
      "image": "gardenai/garden-service:latest",
      "ports": {
        "80": "HTTP"
      }
    }
  },
  "publicEndpoint": {
    "containerName": "garden-backend-service",
    "containerPort": 80,
    "healthCheck": {
      "healthyThreshold": 3,
      "unhealthyThreshold": 5,
      "timeoutSeconds": 5,
      "intervalSeconds": 30,
      "path": "/"
    }
  }
}
